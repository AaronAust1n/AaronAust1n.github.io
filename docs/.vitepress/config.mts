    },

    // Default (English) config
    nav: [
      { text: 'Home', link: '/' },
      { text: 'Blog', link: '/posts/' },
      { text: 'Museum', link: '/museum/', target: '_self' },
      { text: 'Tags', link: '/posts/tags' },
      { text: 'Vote', link: '/vote' }
